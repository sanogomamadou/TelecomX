# =============================================================================
#  TelecomX Platform — environment template
#
#  Copy to .env and fill in the secrets. NEVER commit .env (it is gitignored).
#  Production uses Kubernetes secrets instead of this file (NFR-SEC-007).
# =============================================================================

# --- Environment -------------------------------------------------------------
ENV=development                 # development | staging | production
LOG_LEVEL=INFO
TZ=UTC                          # all timestamps are UTC (ADR-014)

# --- Multi-tenancy (ADR-016) -------------------------------------------------
DEFAULT_TENANT_ID=telecomx-ml

# --- LLM provider (ADR-009) --------------------------------------------------
# Groq is the primary provider. Get a free key at https://console.groq.com
GROQ_API_KEY=

# Model ids are configurable because provider catalogues change faster than code.
LLM_MODEL_SMALL=llama-3.1-8b-instant
LLM_MODEL_TOOLS=llama-3.3-70b-versatile
LLM_MODEL_REASONING=llama-3.3-70b-versatile

# Fallback providers — disabled by default, enable if the primary is exhausted.
LLM_FALLBACK_ENABLED=false
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Budget guards (ADR-009)
LLM_MAX_TOKENS_PER_REQUEST=60000
LLM_MAX_CALLS_PER_REQUEST=30
LLM_DAILY_TOKEN_BUDGET=2000000

# --- PII tokenization (ADR-013) ----------------------------------------------
# CRITICAL SECRET. Losing it breaks token continuity; leaking it enables
# re-identification by brute force. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PII_TOKENIZATION_KEY=
PII_KEY_VERSION=v1
# Separate key for the re-identification vault (must differ from the one above).
PII_VAULT_ENCRYPTION_KEY=

# --- Kafka (ADR-002) ---------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://127.0.0.1:8081   # not 'localhost': see publish/config.py
KAFKA_HEAP_OPTS=-Xmx512m -Xms512m

# --- Object storage, S3 API (ADR-004, ADR-021) -------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=telecomx
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true

# --- Iceberg catalog (ADR-003) -----------------------------------------------
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3://telecom-warehouse/

# --- Trino (ADR-006) ---------------------------------------------------------
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=telecomx
TRINO_CATALOG=iceberg

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telecomx
POSTGRES_USER=telecomx
POSTGRES_PASSWORD=

# --- Redis (semantic cache, rate limiting) -----------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (ADR-010) --------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=telecom_knowledge

# --- MLflow ------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# --- Keycloak (ADR-012) ------------------------------------------------------
# AUTH_MODE=dev bypasses Keycloak with locally signed tokens. It is REFUSED at
# startup when ENV != development (NFR-SEC guard, tested in CI).
AUTH_MODE=dev
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=telecomx
KEYCLOAK_CLIENT_ID=telecomx-api
KEYCLOAK_CLIENT_SECRET=

# --- Observability (ADR-017) -------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=telecomx
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_REDACT_PROMPTS=false       # true in production — prompts may carry context

LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Data generation ---------------------------------------------------------
# Scales throughput down while preserving all statistical proportions.
# 1.0 = production rate (~2475 msg/s), 0.001 = local dev (~2.5 msg/s).
SPEED_FACTOR=0.001
GENERATOR_SEED=42               # fixed seed => reproducible demos and tests

# --- Agent guardrails (ADR-008) ----------------------------------------------
AGENT_MAX_ITERATIONS=12
AGENT_TIMEOUT_SECONDS=120
APPROVAL_EXPIRY_MINUTES=15
# Global kill-switch: when true, agents can read and analyse but never execute
# any action, whatever their risk class (NFR-SEC-011).
AGENT_ACTIONS_DISABLED=false
