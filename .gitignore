# ---------------------------------------------------------------------------
# TelecomX Intelligence Platform - Git ignore rules
# ---------------------------------------------------------------------------

# --- Secrets & local environment (NEVER commit) ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
!**/testdata/*.key
secrets/**/*.yaml
!security/secrets/*.example.yaml
*.kubeconfig
credentials.json
service-account*.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Java / Spark / Iceberg ---
target/
*.class
*.jar
!data-platform/spark/jars/.gitkeep
spark-warehouse/
metastore_db/
derby.log

# --- dbt ---
data-platform/dbt/target/
data-platform/dbt/dbt_packages/
data-platform/dbt/logs/
.user.yml

# --- Terraform ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json

# --- Docker / local volumes ---
.docker-data/
volumes/
data/local/

# --- Local data artefacts (synthetic data is regenerated, never committed) ---
data/raw/
data/bronze/
data/silver/
data/gold/
*.parquet
*.avro
*.orc
!tests/fixtures/**/*.parquet
!tests/fixtures/**/*.avro

# --- ML artefacts ---
mlruns/
mlartifacts/
models/*.pkl
models/*.joblib
models/*.onnx
models/*.pt
*.h5
.mlflow/

# --- Observability local state ---
observability/**/data/
prometheus_data/
grafana_data/
loki_data/

# --- Vector store local state ---
qdrant_storage/

# --- Logs & temp ---
*.log
logs/
tmp/
.tmp/
*.pid

# --- OS / IDE ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
*.swp
*.swo
*~

